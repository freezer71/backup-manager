# Profil AppArmor du conteneur runner de Backup Manager.
# Installation sur l'hôte (une fois, puis après chaque modification de ce fichier) :
#   sudo install -m 644 deploy/apparmor/bm-runner /etc/apparmor.d/bm-runner
#   sudo apparmor_parser -r -W /etc/apparmor.d/bm-runner
#
# Base : le profil docker-default de Docker (moby/profiles, apparmor/template.go). Différences :
# - mount, remount, umount et pivot_root autorisés : bubblewrap construit la sandbox de chaque run ;
# - création d'espaces de noms utilisateur refusée (doublon du profil seccomp du runner) ;
# - écriture dans /proc/sys refusée en entier (docker-default laisse /proc/sys/kernel/shm*).
# Les scripts tournent sans aucune capacité : ils ne peuvent pas monter eux-mêmes, quoi que ce profil permette.

abi <abi/4.0>,

#include <tunables/global>

profile bm-runner flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,

  mount,
  remount,
  umount,
  pivot_root,
  deny userns,

  signal (receive) peer=unconfined,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=bm-runner,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/** w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=bm-runner,
}
